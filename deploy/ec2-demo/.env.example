# BackPocket OS AI EC2 Docker Compose demo environment.
# Copy this file to .env on the EC2 instance and replace BP_API_KEY.
# This is a demo config, not a production config.

APP_ENV=demo
ENV=demo
BP_PUBLIC_PORT=8000

BP_OWNER_NAME=Demo Owner
BP_BUSINESS_TYPE=construction

# Keep these enabled for the safe live demo path.
DEMO_MODE=1
DISABLE_BACKGROUND_POLLING=1
REQUIRE_BP_API_KEY=1

# Required. Generate a real demo key:
# python3 -c "import secrets; print(secrets.token_hex(24))"
BP_API_KEY=replace_with_generated_api_key

# Optional browser CORS origin. Example: http://YOUR_EC2_PUBLIC_IP:8000
FRONTEND_ORIGIN=

# Optional AI keys. Leave blank if the demo does not need live AI calls.
# DEMO_* names are used to avoid accidentally inheriting host shell secrets.
DEMO_GEMINI_API_KEY=
DEMO_OPENROUTER_API_KEY=

# Optional Google Sheets integration. Leave blank for the safe web demo.
DEMO_SPREADSHEET_ID=

# Leave blank for this demo unless Supabase auth is intentionally configured.
DEMO_SUPABASE_JWT_SECRET=
