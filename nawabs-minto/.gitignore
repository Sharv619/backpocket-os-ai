# The parent repo's .gitignore blanket-ignores *.json and package-lock.json —
# un-ignore the config files this subproject actually needs tracked.
!/package.json
!/package-lock.json
!/tsconfig.json
!/tsconfig.app.json
!/tsconfig.node.json
!/.oxlintrc.json
!/firebase.json
!/firestore.indexes.json
!/.firebaserc
!/functions/package.json
!/functions/package-lock.json
!/functions/tsconfig.json

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
